//kage:unit pixels
package main

var InnerColor vec4
var OuterColor vec4
var Center vec2
var Radius float

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	// Calculate a ratio (0.0 to 1.0) based on position relative to Center point with Radius
	ratio := clamp(length(srcPos-Center)/max(Radius, 0.0001), 0.0, 1.0)
	return mix(InnerColor, OuterColor, ratio)
}
